+# --------------------------------------------------------------------------- #
+#  Démarrage automatique (HKCU)
+# --------------------------------------------------------------------------- #
+def _autostart_command() -> str:
+    if getattr(sys, "frozen", False):
+        return f'"{sys.executable}" --minimized'
+    exe = Path(sys.executable)
+    pythonw = exe.with_name("pythonw.exe")          # pas de console au démarrage
+    if pythonw.is_file():
+        exe = pythonw
+    return f'"{exe}" "{Path(__file__).resolve()}" --minimized'
+
+
+def _set_autostart(actif: bool) -> bool:
+    if sys.platform != "win32":
+        return False
+    if actif and os.environ.get("NEXUS_PORTABLE") == "1":
+        return False
+    import winreg
+    key = r"Software\Microsoft\Windows\CurrentVersion\Run"
+    try:
+        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, key, 0, winreg.KEY_SET_VALUE) as k:
+            if actif:
+                winreg.SetValueEx(k, APP_NAME, 0, winreg.REG_SZ, _autostart_command())
+            else:
+                try:
+                    winreg.DeleteValue(k, APP_NAME)
+                except FileNotFoundError:
+                    pass
+        return True
+    except OSError as exc:
+        print(f"[Démarrage] {exc}")
+        return False
+
+
+# --------------------------------------------------------------------------- #
+#  Notifications Windows
+# --------------------------------------------------------------------------- #
+def _init_native_notifier():
+    """Renvoie une fonction toast, ou None si winotify n'est pas disponible."""
+    try:
+        from winotify import Notification
+    except Exception as exc:
+        print(f"[Notifications] winotify indisponible : {exc}")
+        return None
+    import paths
+    icon = paths.APP_DIR / "panel.ico"
+
+    def notify(titre: str, texte: str) -> bool:
+        try:
+            n = Notification(app_id=APP_NAME, title=str(titre)[:64], msg=str(texte)[:256],
+                             icon=str(icon) if icon.is_file() else "")
+            n.show()
+            return True
+        except Exception as exc:
+            print(f"[Notifications] {exc}")
+            return False
+    return notify
+
+
+# --------------------------------------------------------------------------- #
+#  Fenêtre, tray, arrêt (Win32 pour les appels depuis le tray / HTTP)
+# --------------------------------------------------------------------------- #
+def _find_window_handle(require_title: bool = False) -> int | None:
+    """Handle de la fenêtre NEXUS (titre « NEXUS »), sinon la plus grande fenêtre du processus.
+
+    Attention : un lanceur python.exe de venv peut créer un processus enfant ; c'est ce
+    processus qui exécute le script et possède la fenêtre, d'où l'utilisation de os.getpid()
+    ici (et non du PID du lanceur).
+    """
+    if sys.platform != "win32":
+        return None
+    import ctypes
+    from ctypes import wintypes
+
+    class RECT(ctypes.Structure):
+        _fields_ = [("left", wintypes.LONG), ("top", wintypes.LONG),
+                    ("right", wintypes.LONG), ("bottom", wintypes.LONG)]
+
+    user32 = ctypes.windll.user32
+    pid = os.getpid()
+    found: list[tuple[int, int, int]] = []
+
+    @ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)
+    def cb(hwnd, _lparam):
+        p = wintypes.DWORD()
+        user32.GetWindowThreadProcessId(hwnd, ctypes.byref(p))
+        if p.value == pid:
+            r = RECT()
+            user32.GetWindowRect(hwnd, ctypes.byref(r))
+            area = max(0, r.right - r.left) * max(0, r.bottom - r.top)
+            length = user32.GetWindowTextLengthW(hwnd)
+            buf = ctypes.create_unicode_buffer(length + 1)
+            user32.GetWindowTextW(hwnd, buf, length + 1)
+            titre = buf.value.strip()
+            # Titre exact de la fenêtre pywebview (« NEXUS » ou « ⚠ NEXUS »).
+            # Ne pas accepter « GDI+ Window (NEXUS.exe) », qui est un autre handle.
+            if re.match(r"^(?:⚠\s*)?NEXUS(?:\s|$)", titre, re.I):
+                found.append((1 << 60, area, int(hwnd)))
+            elif not require_title:
+                found.append((area, area, int(hwnd)))
+        return True
+
+    user32.EnumWindows(cb, 0)
+    return max(found)[2] if found else None
+
+
+def _watch_window() -> None:
+    """Appelé par pywebview après le démarrage de la boucle graphique."""
+    global _WINDOW_HANDLE
+    for _ in range(100):
+        _WINDOW_HANDLE = _find_window_handle(require_title=True)
+        if _WINDOW_HANDLE:
+            break
+        time.sleep(.1)
+    if _WINDOW_HANDLE is None:                    # titre pas encore posé : repli
+        _WINDOW_HANDLE = _find_window_handle()
+    if _ARGS is not None and _ARGS.minimized and _WINDOW_HANDLE and sys.platform == "win32":
+        ctypes.windll.user32.ShowWindow(_WINDOW_HANDLE, 0)      # SW_HIDE : démarrage dans le tray
+
+
+def _show_window(*_args) -> None:
+    global _WINDOW_HANDLE
+    if sys.platform == "win32":
+        if _WINDOW_HANDLE and not ctypes.windll.user32.IsWindow(_WINDOW_HANDLE):
+            _WINDOW_HANDLE = None
+        _WINDOW_HANDLE = _WINDOW_HANDLE or _find_window_handle(require_title=True) or _find_window_handle()
+        if _WINDOW_HANDLE:
+            ctypes.windll.user32.ShowWindow(_WINDOW_HANDLE, 5)  # SW_SHOW
+            ctypes.windll.user32.ShowWindow(_WINDOW_HANDLE, 9)  # SW_RESTORE
+            ctypes.windll.user32.SetForegroundWindow(_WINDOW_HANDLE)
+            if ctypes.windll.user32.IsWindowVisible(_WINDOW_HANDLE):
+                return
+    if _WINDOW is None:
+        return
+    try:
+        _WINDOW.show()
+    except Exception:
+        pass
+    try:
+        _WINDOW.restore()
+    except Exception:
+        pass
+
+
+def _show_tab(tab: str, *_args) -> None:
+    _show_window()
+    if _WINDOW is not None:                       # dans un fil : ne bloque jamais le tray
+        def aller():
+            try:
+                _WINDOW.evaluate_js(f"location.hash = '#{tab}'")
+            except Exception:
+                pass
+        threading.Thread(target=aller, daemon=True, name="onglet").start()
+
+
+def _on_closing() -> bool:
+    if _QUITTING or _ARGS is None or _ARGS.no_tray or _TRAY is None:
+        return True
+    if sys.platform == "win32":
+        handle = _WINDOW_HANDLE or _find_window_handle(require_title=True)
+        if handle and ctypes.windll.user32.IsWindow(handle):
+            ctypes.windll.user32.ShowWindow(handle, 0)          # SW_HIDE (le handle reste vivant)
+            try:
+                _TRAY.notify("NEXUS continue en arrière-plan", APP_NAME)
+            except Exception:
+                pass
+            return False
+    try:
+        _WINDOW.hide()
+        _TRAY.notify("NEXUS continue en arrière-plan", APP_NAME)
+    except Exception:
+        pass
+    return False
+
+
+def _quit(*_args) -> None:
+    global _QUITTING
+    _QUITTING = True
+    _STOP.set()
+    if _TRAY is not None:
+        try:
+            _TRAY.stop()
+        except Exception:
+            pass
+    if sys.platform == "win32":
+        handle = _WINDOW_HANDLE or _find_window_handle(require_title=True)
+        if handle and ctypes.windll.user32.IsWindow(handle):
+            if ctypes.windll.user32.PostMessageW(handle, 0x0010, 0, 0):   # WM_CLOSE
+                return
+    if _WINDOW is not None:
+        try:
+            _WINDOW.destroy()
+        except Exception:
+            pass
+
+
+def _start_tray() -> None:
+    global _TRAY
+    if _ARGS is None or _ARGS.no_tray:
+        return
+    try:
+        import pystray
+        from PIL import Image
+        import paths
+        icon_path = paths.APP_DIR / "panel.ico"
+        image = Image.open(icon_path).convert("RGBA") if icon_path.is_file() else Image.new("RGBA", (64, 64), (0, 240, 255, 255))
+        menu = pystray.Menu(
+            pystray.MenuItem("Ouvrir NEXUS", _show_window, default=True),
+            pystray.MenuItem("Statistiques", lambda *_: _show_tab("statistiques")),
+            pystray.MenuItem("Deck", lambda *_: _show_tab("deck")),
+            pystray.Menu.SEPARATOR,
+            pystray.MenuItem("Quitter NEXUS", _quit),
+        )
+        _TRAY = pystray.Icon(APP_NAME, image, "NEXUS — tableau de bord", menu)
+        _TRAY.run_detached()
+    except Exception as exc:
+        print(f"[Tray] indisponible : {exc}")
+        _TRAY = None
+
+
+# --------------------------------------------------------------------------- #
+#  Serveur
+# --------------------------------------------------------------------------- #
+def _run_server(host: str, port: int) -> None:
+    global _SERVER
+    import uvicorn
+    import app
+    config = uvicorn.Config(app.app, host=host, port=port, log_level="warning", access_log=False)
+    _SERVER = uvicorn.Server(config)
+    _SERVER.run()
+
+
+def _server_ready(timeout: float = 30.0) -> bool:
+    fin = time.time() + timeout
+    while time.time() < fin:
+        if _SERVER is not None and getattr(_SERVER, "started", False):
+            return True
+        if _SERVER_THREAD is not None and not _SERVER_THREAD.is_alive():
+            return False
+        time.sleep(.1)
+    return False
+
+
+def _shutdown() -> None:
+    global _QUITTING
+    _QUITTING = True
+    if _SERVER is not None:
+        try:
+            _SERVER.should_exit = True
+        except Exception:
+            pass
+    if _SERVER_THREAD is not None:
+        _SERVER_THREAD.join(5)
+    try:
+        import app
+        app.stop_services()
+    except Exception:
+        pass
+    try:
+        import paths
+        paths.clear_runtime()
+    except Exception:
+        pass
+
+
+# --------------------------------------------------------------------------- #
+#  Main
+# --------------------------------------------------------------------------- #
+def main() -> int:
+    global _ARGS, _SERVER_THREAD, _WINDOW
+
+    _ARGS = _parser().parse_args()
+    # Détecté avant les commandes --install-autostart et --configure : le drapeau
+    # portable doit être connu de paths.py et du lanceur.
+    if _ARGS.portable or _portable_flag():
+        os.environ["NEXUS_PORTABLE"] = "1"
+    if _ARGS.notify_test:
+        notifier = _init_native_notifier()
+        if notifier is None:
+            return 1
+        return 0 if notifier("NEXUS", "Notification native de test.") else 1
+    if _ARGS.install_autostart:
+        ok = _set_autostart(True)
+        if os.environ.get("NEXUS_PORTABLE") == "1":
+            print("Le démarrage automatique n'est pas disponible en version portable.")
+        else:
+            print("Démarrage automatique activé." if ok else "Impossible d'activer le démarrage automatique.")
+        return 0 if ok else 1
+    if _ARGS.remove_autostart:
+        ok = _set_autostart(False)
+        print("Démarrage automatique retiré." if ok else "Impossible de modifier le démarrage automatique.")
+        return 0 if ok else 1
+
+    # Les variables doivent être posées AVANT d'importer paths/app.
+    if _ARGS.data_dir:
+        os.environ["NEXUS_DATA_DIR"] = _ARGS.data_dir
+    if _ARGS.configure:
+        return _run_setup()
+    if not _single_instance():
+        if not _activate_existing():
+            _message("NEXUS tourne déjà dans cette session.")
+        return 0
+
+    token = secrets.token_urlsafe(32)
+    # Port stable (localStorage du thème, disposition, etc.) ; on bascule sur un port libre
+    # seulement si le port habituel est occupé. 8765 est distinct du mode navigateur (8000).
+    port = _ARGS.port or int(os.environ.get("NEXUS_PORT") or 0) or _preferred_port()
+    os.environ["NEXUS_TOKEN"] = token
+    os.environ["NEXUS_NATIVE"] = "1"
+    os.environ["NEXUS_OPEN_BROWSER"] = "0"
+    os.environ["NEXUS_PORT"] = str(port)
+
+    import paths
+    paths.prepare()                    # _dire() est sûr même avec pythonw (stdout None)
+    paths.clear_runtime()              # enlève un éventuel runtime.json laissé par un crash
+    import logs
+    log_path = logs.install()
+    import sante
+    sante.install()
+
+    import config
+    try:
+        config.migrer()
+    except Exception as exc:
+        print(f"[Config] AVERTISSEMENT : migration impossible ({exc})")
+    config.load(force=True)
+    for warning in config.warnings:
+        print(f"[Config] AVERTISSEMENT : {warning}")
+
+    # Première installation : la fenêtre de configuration s'ouvre dans un processus séparé
+    # (pywebview ne peut démarrer qu'une fois par processus).
+    from deck import Deck
+    if not Deck.password_set(config.get("deck")) and not _ARGS.smoke_test:
+        cmd = ([sys.executable, "--configure"] if getattr(sys, "frozen", False)
+               else [sys.executable, str(Path(__file__).resolve()), "--configure"])
+        try:
+            subprocess.run(cmd, cwd=str(Path(__file__).resolve().parent), timeout=900)
+        except Exception as exc:
+            print(f"[Config] fenêtre de configuration impossible : {type(exc).__name__}: {exc}")
+        config.load(force=True)
+        if not Deck.password_set(config.get("deck")):
+            _message("Le mot de passe du stream deck n'est pas défini.\n"
+                     "Le Deck restera désactivé jusqu'à la configuration "
+                     "(menu Démarrer → Configurer NEXUS, ou NEXUS.exe --configure).")
+
+    import app
+    app.PORT = port
+    try:
+        app._journaliser_resultat_maj()
+    except Exception:
+        pass
+    notifier = _init_native_notifier()
+    if notifier is not None:
+        app.set_native_notifier(notifier)
+    app.set_activate_callback(_show_window)
+    app.remote_svc.active = app.remote_svc.enabled
+    host = "0.0.0.0" if app.remote_svc.enabled else "127.0.0.1"
+
+    _SERVER_THREAD = threading.Thread(target=_run_server, args=(host, port), daemon=True, name="serveur")
+    _SERVER_THREAD.start()
+    if not _server_ready():
+        _message("NEXUS n'a pas pu démarrer.\n\nConsultez le journal :\n" + str(log_path or paths.LOG_FILE))
+        _shutdown()
+        return 1
+    paths.write_runtime(port, token)
+    app.start_services()
+
+    try:
+        import webview
+    except Exception as exc:
+        print(f"[Fenêtre] pywebview indisponible : {exc}")
+        import webbrowser
+        q = "/?token=" + urllib.parse.quote(token, safe="") + ("&native=1" if notifier is not None else "&native=0")
+        webbrowser.open(f"http://127.0.0.1:{port}{q}")
+        _message("La fenêtre native n'est pas disponible (pywebview manquant).\nL'interface s'ouvre dans le navigateur.\n\nFermez cette fenêtre pour arrêter NEXUS.")
+        try:
+            while not _STOP.wait(1):
+                pass
+        except KeyboardInterrupt:
+            pass
+        _shutdown()
+        return 1
+
+    _start_tray()
+    demarre_reduit = bool(_ARGS.minimized and _TRAY is not None)
+    q = "/?token=" + urllib.parse.quote(token, safe="")
+    q += "&native=1" if notifier is not None else "&native=0"
+    url = f"http://127.0.0.1:{port}{q}"
+    _WINDOW = webview.create_window(
+        APP_NAME, url,
+        width=1280, height=860, min_size=(1024, 700),
+        minimized=demarre_reduit, focus=not demarre_reduit,
+        background_color="#06060a",
+        text_select=True,
+    )
+    _WINDOW.events.closing += _on_closing
+
+    if _ARGS.smoke_test:
+        def _fermer_bientot():
+            time.sleep(4)
+            _quit()
+        threading.Thread(target=_fermer_bientot, daemon=True, name="smoke-test").start()
+
+    try:
+        webview_dir = paths.DATA_DIR / "webview"
+        webview_dir.mkdir(parents=True, exist_ok=True)
+        webview.start(_watch_window, debug=_ARGS.debug, private_mode=False,
+                      storage_path=str(webview_dir),
+                      icon=str(paths.APP_DIR / "panel.ico") if (paths.APP_DIR / "panel.ico").is_file() else None)
+    finally:
+        _shutdown()
+    return 0
+
+
+def _port_free(port: int) -> bool:
+    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    try:
+        s.bind(("0.0.0.0", int(port)))
+        return True
+    except OSError:
+        return False
+    finally:
+        s.close()
+
+
+def _preferred_port() -> int:
+    """Port stable pour conserver le localStorage (thème, disposition, réglages)."""
+    for port in (8765, 8766, 8767):
+        if _port_free(port):
+            return port
+    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    try:
+        s.bind(("0.0.0.0", 0))
+        return int(s.getsockname()[1])
+    finally:
+        s.close()
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except Exception as exc:
+        import traceback
+        traceback.print_exc()
+        try:
+            _shutdown()
+        except Exception:
+            pass
+        _message(f"NEXUS n'a pas pu démarrer.\n\n{type(exc).__name__}: {exc}\n\n"
+                 "Consultez logs\\nexus.log pour le détail.")
+        raise SystemExit(1)
diff --git new/outils/appliquer_maj.ps1 new/outils/appliquer_maj.ps1
new file mode 100644
index 0000000..032f6d9
--- /dev/null
+++ new/outils/appliquer_maj.ps1
@@ -0,0 +1,192 @@
+param(
+    [Parameter(Mandatory = $true)]
+    [string]$Job
+)
+
+# Helper de mise à jour native de NEXUS.
+# Lancé par maj_natif.py avec un fichier de travail JSON. Il attend la fin de
+# NEXUS, lance l'installeur Inno en silence, relance l'application et vérifie
+# qu'elle écrit bien maj/demarrage_ok.json. En cas d'échec, il remet la
+# sauvegarde de l'installation précédente et relance l'ancienne version.
+#
+# Aucun chemin n'est interprété par un shell : tout vient du JSON, et les
+# appels à Start-Process / Copy-Item utilisent des chemins littéraux.
+
+$ErrorActionPreference = "Stop"
+$j = Get-Content -LiteralPath $Job -Raw -Encoding UTF8 | ConvertFrom-Json
+
+function Write-Log([string]$Message) {
+    try {
+        $ligne = "{0} {1}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Message
+        Add-Content -LiteralPath $j.log -Value $ligne -Encoding UTF8
+    } catch {
+        # Le journal ne doit jamais empêcher la mise à jour.
+    }
+}
+
+function Write-JsonFile([string]$Chemin, $Donnees) {
+    $json = $Donnees | ConvertTo-Json -Depth 8
+    $utf8 = New-Object System.Text.UTF8Encoding($false)
+    [System.IO.File]::WriteAllText($Chemin, $json, $utf8)
+}
+
+function Write-Result([bool]$Ok, [string]$Type, [string]$Message) {
+    $donnees = [ordered]@{
+        ok         = $Ok
+        type       = $Type
+        de         = [string]$j.from_version
+        vers       = [string]$j.expected_version
+        date       = [double]([DateTimeOffset]::UtcNow.ToUnixTimeSeconds())
+        message    = $Message
+        journalise = $false
+    }
+    Write-JsonFile -Chemin $j.result -Donnees $donnees
+    Write-Log ("Résultat : " + $Message)
+}
+
+function Stop-Nexus {
+    # Laisse à NEXUS le temps de s'arrêter proprement, puis force si besoin.
+    $limite = (Get-Date).AddSeconds(20)
+    while ((Get-Date) -lt $limite) {
+        $restants = @(Get-Process -Name "NEXUS" -ErrorAction SilentlyContinue)
+        if ($restants.Count -eq 0) {
+            Start-Sleep -Milliseconds 800      # laisse WebView2 et les DLL se libérer
+            return
+        }
+        foreach ($p in $restants) {
+            try { Stop-Process -Id $p.Id -Force -ErrorAction SilentlyContinue } catch { }
+        }
+        Start-Sleep -Milliseconds 500
+    }
+}
+
+function Wait-Parent {
+    try {
+        $parent = Get-Process -Id ([int]$j.parent_pid) -ErrorAction SilentlyContinue
+        if ($parent) { $null = $parent.WaitForExit(30000) }
+    } catch {
+        # Déjà arrêté : continue.
+    }
+}
+
+function Test-Marker {
+    if (-not (Test-Path -LiteralPath $j.marker)) { return $false }
+    try {
+        $m = Get-Content -LiteralPath $j.marker -Raw -Encoding UTF8 | ConvertFrom-Json
+        return ([string]$m.version -eq [string]$j.expected_version) -and
+               ([double]$m.date -ge [double]$j.started)
+    } catch {
+        return $false
+    }
+}
+
+function Wait-Marker([int]$Timeout) {
+    $limite = (Get-Date).AddSeconds($Timeout)
+    while ((Get-Date) -lt $limite) {
+        Start-Sleep -Seconds 2
+        if (Test-Marker) { return $true }
+    }
+    return $false
+}
+
+function Start-App {
+    if (-not (Test-Path -LiteralPath $j.app_exe)) {
+        throw "exécutable introuvable : $($j.app_exe)"
+    }
+    $arguments = @()
+    if ($j.restart_args) { $arguments = @($j.restart_args) }
+    if ($arguments.Count -gt 0) {
+        Start-Process -FilePath $j.app_exe -WorkingDirectory $j.app_dir -ArgumentList $arguments | Out-Null
+    } else {
+        Start-Process -FilePath $j.app_exe -WorkingDirectory $j.app_dir | Out-Null
+    }
+    Write-Log "NEXUS relancé : $($j.app_exe)"
+}
+
+function Restore-App {
+    if (-not (Test-Path -LiteralPath $j.backup_dir)) {
+        throw "sauvegarde introuvable : $($j.backup_dir)"
+    }
+    Stop-Nexus
+    Get-ChildItem -LiteralPath $j.app_dir -Force -ErrorAction SilentlyContinue | ForEach-Object {
+        Remove-Item -LiteralPath $_.FullName -Recurse -Force -ErrorAction Stop
+    }
+    Get-ChildItem -LiteralPath $j.backup_dir -Force -ErrorAction Stop | ForEach-Object {
+        Copy-Item -LiteralPath $_.FullName -Destination $j.app_dir -Recurse -Force -ErrorAction Stop
+    }
+    Write-Log "Ancienne installation restaurée depuis $($j.backup_dir)"
+}
+
+function Clear-Travail {
+    Remove-Item -LiteralPath $j.marker -Force -ErrorAction SilentlyContinue
+    Remove-Item -LiteralPath $Job -Force -ErrorAction SilentlyContinue
+}
+
+function Install-NouvelleVersion {
+    $ligne = '/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /CLOSEAPPLICATIONS /DIR="' +
+             [string]$j.app_dir + '" /LOG="' + [string]$j.installer_log + '"'
+    Write-Log "Installeur : $($j.installer)"
+    $p = Start-Process -FilePath $j.installer -ArgumentList $ligne -Wait -PassThru
+    Write-Log "Installeur terminé, code $($p.ExitCode)"
+    if ($p.ExitCode -notin @(0, 3010)) {
+        throw "l'installeur a échoué (code $($p.ExitCode))"
+    }
+    if (-not (Test-Path -LiteralPath $j.app_exe)) {
+        throw "l'installeur n'a pas remis NEXUS.exe en place"
+    }
+}
+
+try {
+    Write-Log "Début de la mise à jour ($($j.action), $($j.from_version) -> $($j.expected_version))"
+    Wait-Parent
+    Stop-Nexus
+
+    if ($j.action -eq "restore") {
+        Restore-App
+        Start-App
+        if (Wait-Marker ([int]$j.timeout)) {
+            Write-Result $true "retour" ("Retour à la version " + $j.expected_version + " effectué (tes données sont conservées).")
+            Clear-Travail
+            exit 0
+        }
+        throw "la version restaurée n'a pas confirmé son démarrage"
+    }
+
+    Install-NouvelleVersion
+    Start-App
+    if (Wait-Marker ([int]$j.timeout)) {
+        $note = ""
+        if ($j.signature_note) { $note = " " + ([string]$j.signature_note).TrimEnd(".") + "." }
+        Write-Result $true "installation" ("Mise à jour vers la version " + $j.expected_version + " réussie." + $note)
+        Clear-Travail
+        try {
+            Remove-Item -LiteralPath (Split-Path -Path $j.installer -Parent) -Recurse -Force -ErrorAction SilentlyContinue
+        } catch { }
+        exit 0
+    }
+
+    throw "la nouvelle version n'a pas confirmé son démarrage"
+} catch {
+    $erreur = $_.Exception.Message
+    Write-Log "ERREUR : $erreur"
+    try {
+        if ($j.action -eq "install") {
+            Stop-Nexus
+            Restore-App
+            Start-App
+            $message = "La mise à jour vers la version $($j.expected_version) a échoué : $erreur. " +
+                       "La version $($j.from_version) a été restaurée automatiquement."
+            Write-Result $false "rollback" $message
+        } else {
+            $message = "Le retour à la version $($j.expected_version) a échoué ($erreur)."
+            Write-Result $false "retour" $message
+        }
+    } catch {
+        $seconde = $_.Exception.Message
+        Write-Log "ERREUR pendant la restauration : $seconde"
+        Write-Result $false "rollback" ("Mise à jour impossible ($erreur) et restauration impossible ($seconde). " +
+                                      "Réinstalle NEXUS avec l'installeur de la version voulue.")
+    }
+    Clear-Travail
+    exit 1
+}
